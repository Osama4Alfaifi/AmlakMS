# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase-export-*/
.firebase-emulator-data/

# service account keys — never commit these (full admin access to the
# Firebase/GCP project). Keep them outside the repo if possible.
*firebase-adminsdk*.json
serviceAccountKey.json
service-account*.json

# vercel
.vercel

# android (Capacitor) — local.properties has a machine-specific SDK path,
# the rest are build outputs; the android/ project structure itself is
# committed.
/android/local.properties
/android/.gradle/
/android/app/build/
/android/build/
/android/captures/
*.apk
*.aab

# typescript
*.tsbuildinfo
next-env.d.ts
