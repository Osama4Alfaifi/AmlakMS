rules_version = '2';

// EXAMPLE production rules — copy to firestore.rules once real Firebase Auth
// is wired up and each user's role is stored in a `users/{uid}` document
// (field `role`: "admin" | "owner" | "tenant" | "technician") set at sign-up.
// This is NOT active yet — see firestore.rules for the current dev rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == "admin";
    }

    // Admins manage everything.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Everyone signed in can read reference/catalog data.
    match /properties/{id} {
      allow read: if isSignedIn();
    }

    // Users can only read/update their own profile document.
    match /users/{uid} {
      allow read, update: if isSignedIn() && request.auth.uid == uid;
    }

    // Tenants/owners can create tickets and maintenance requests, and read
    // their own; technicians can read/update ones assigned to them.
    match /supportTickets/{id} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn();
    }

    match /maintenanceRequests/{id} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn();
    }
  }
}
