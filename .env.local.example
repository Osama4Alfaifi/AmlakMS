# Copy to .env.local and fill in for a REAL Firebase project (production).
# Get these values from Firebase Console → Project settings → General → Your apps.

NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side (Admin SDK) — for seeding/scripts against the real project.
# Generate a service account key from Firebase Console → Project settings →
# Service accounts → Generate new private key, then paste the JSON as a
# single-line string here (or use GOOGLE_APPLICATION_CREDENTIALS instead).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
