rules_version = '2';

// Requires real Firebase Authentication (see lib/auth-context.tsx) — every
// signed-in account has a users/{uid} profile doc (role + linkedId) created
// by scripts/seed.ts. These rules mirror the same "only see what's yours"
// scoping the UI applies at the database level too, so it can't be bypassed
// by talking to Firestore directly.
//
// IMPORTANT — Firestore `list` rule evaluation: a security rule for a list
// (collection/query) request must hold for the query AS ISSUED, not per
// returned document. Firestore does not filter a query down to "the docs
// you're allowed to see" — it proves (or fails to prove) the rule holds for
// every possible result of that exact query, then allows or denies the
// whole request. That means an unconstrained `collection(db, name)` read
// only ever works for roles whose access doesn't depend on document data
// (admin via the wildcard below; technician via a role check that's true
// regardless of the document). Anyone whose access depends on a field on
// the document (createdByUid, ownerId, category, ...) MUST query with a
// matching `where()` clause so Firestore can prove the rule holds for the
// constrained result set — see lib/firestore/hooks.ts (useMy*, useOwner*,
// useSupportTicketsByCategory) for the client side of this.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return signedIn() ? myProfile().role : null;
    }

    function isAdmin() {
      return signedIn() && myRole() == "admin";
    }

    function isTechnician() {
      return signedIn() && myRole() == "technician";
    }

    function isAccountant() {
      return signedIn() && myRole() == "accountant";
    }

    // An accountant only manages the owners assigned to them (see
    // app/admin/users) — this proves ownership scope for a specific
    // document's ownerId. Safe to call even when myProfile().ownerIds is
    // absent (non-accountant profiles): every caller guards this behind
    // myRole() == "accountant" first, and `&&`/`||` short-circuit here, so
    // the missing-field access never happens for other roles.
    function isMyOwner(ownerId) {
      return isAccountant() && ownerId in myProfile().ownerIds;
    }

    function isLeasingAgent() {
      return signedIn() && myRole() == "leasingAgent";
    }

    function isMaintenanceStaff() {
      return signedIn() && myRole() == "maintenanceStaff";
    }

    // Admin manages everything.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // An account can read its own profile (role/linkedId are provisioned
    // server-side by the seed script, not self-editable from the client).
    match /users/{uid} {
      // Accountants can read every profile too, to resolve actor names on
      // the activity log (app/admin/audit-log) — everyone else only ever
      // sees their own.
      allow read: if signedIn() && (request.auth.uid == uid || isAccountant());
    }

    // Reference/catalog data: any signed-in account can read it; writes go
    // through the admin rule above. Accountants are narrowed to properties
    // whose owner is assigned to them (myRole() != "accountant" short-
    // circuits this for every other role, leaving their access unchanged).
    match /properties/{id} {
      allow read: if signedIn() && (myRole() != "accountant" || isMyOwner(resource.data.ownerId));
    }
    match /owners/{id} { allow read: if signedIn(); }
    // Accountants register a new tenant inline when writing a contract for
    // someone not yet in the system (update covers back-filling the new
    // tenant's contractId once the contract itself has been created).
    match /tenants/{id} {
      allow read: if signedIn();
      allow create, update: if isAccountant();
    }
    match /technicians/{id} { allow read: if signedIn(); }
    // Accountants create/manage contracts (and their payment schedules) —
    // see app/admin/contracts and lib/contracts/schedule.ts — narrowed to
    // the owners assigned to them (myRole() != "accountant" preserves
    // every other role's existing unrestricted read).
    match /contracts/{id} {
      allow read: if signedIn() && (myRole() != "accountant" || isMyOwner(resource.data.ownerId));
      allow create: if isMyOwner(request.resource.data.ownerId);
      allow update: if isMyOwner(resource.data.ownerId);
    }
    // Clients: reference data readable by anyone signed in; leasing agents
    // additionally manage the CRM fields (stage/interestedPropertyId) on
    // lead records, and can add new leads.
    match /clients/{id} {
      allow read: if signedIn();
      allow create, update: if isLeasingAgent();
    }
    match /invoices/{id} { allow read: if signedIn(); }
    match /accountManagers/{id} { allow read: if signedIn(); }
    match /systemUsers/{id} { allow read: if signedIn(); }
    // Same accountant narrowing as properties above.
    match /buildings/{id} {
      allow read: if signedIn() && (myRole() != "accountant" || isMyOwner(resource.data.ownerId));
    }
    match /units/{id} {
      allow read: if signedIn() && (myRole() != "accountant" || isMyOwner(resource.data.ownerId));
    }
    // Maintenance staff manage the vendor directory day to day.
    match /vendors/{id} {
      allow read: if signedIn();
      allow create, update: if isMaintenanceStaff();
    }

    // Viewings: internal CRM tooling. Leasing agents run the pipeline day to
    // day (read/create/update); everyone else falls through to
    // default-deny except admin (wildcard above).
    match /viewings/{id} {
      allow read, create, update: if isLeasingAgent();
    }

    // Document links are internal admin tooling only — no explicit rule:
    // falls through to default-deny for everyone except admin (wildcard).

    // Receipt/disbursement vouchers — accountant tooling.
    match /vouchers/{id} {
      allow read, create, update: if isAccountant();
    }

    // Append-only audit trail: anyone signed in can log their own action
    // (so a tenant filing a maintenance request can log it too). Read is
    // admin (wildcard above, sees every actor) plus accountant narrowed to
    // their own entries only (app/admin/audit-log) — an accountant with
    // several owners still isn't meant to see other accountants' actions.
    match /auditLogs/{id} {
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isAccountant() && resource.data.actorUid == request.auth.uid;
    }

    // Expenses: owners only see expenses on their own properties (ownerId
    // is denormalized onto each expense at creation time, same
    // list-provability reason as maintenanceRequests.ownerId above).
    // Accountants see and manage expenses on the owners assigned to them
    // (including approving payment/status update). Admin is covered by the
    // wildcard rule.
    match /expenses/{id} {
      allow read: if signedIn() && (
        isMyOwner(resource.data.ownerId) ||
        (myRole() == "owner" && resource.data.ownerId == myProfile().linkedId)
      );
      allow create: if isMyOwner(request.resource.data.ownerId);
      allow update: if isMyOwner(resource.data.ownerId);
    }

    // Quotes: admin/owner can create. Any signed-in account can read at the
    // rules level — the UI narrows an owner's view to quotes tied to their
    // own properties (app/quotes/page.tsx), but quotes don't carry a
    // propertyId to check here (only a free-text propertyTitle), so this
    // layer can't enforce the same narrowing without denormalizing an
    // ownerId onto each quote. Worth doing before real production use.
    match /quotes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (myRole() == "admin" || myRole() == "owner");
    }

    // Support tickets: anyone signed in can file one (as themselves only).
    // Only the sender, or the staff team routed to that category, can read
    // or update it. The technician disjunct only works for unconstrained
    // list queries because it's a constant per-user fact (see the note up
    // top); the app queries `where("category","==","الدعم الفني")` for the
    // technical-support board so that constraint plus this rule line up.
    match /supportTickets/{id} {
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.createdByUid == request.auth.uid ||
        (resource.data.category == "الدعم الفني" && isTechnician())
      );
      allow update: if signedIn() && resource.data.category == "الدعم الفني" && isTechnician();
    }

    // Maintenance requests: tenants file their own (as themselves only).
    // Visible to the tenant who filed it, technicians and maintenance staff
    // (staff — constant per-user fact, safe for an unconstrained list), and
    // the owner of the property it's on (ownerId is copied onto the request
    // at creation time so this rule doesn't need a cross-collection get()
    // keyed by a per-document field, which has the same list-provability
    // problem). Technicians and maintenance staff can both update status —
    // maintenance staff also assigns technician/vendor from
    // app/admin/maintenance.
    match /maintenanceRequests/{id} {
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.createdByUid == request.auth.uid ||
        isTechnician() ||
        isMaintenanceStaff() ||
        (myRole() == "owner" && resource.data.ownerId == myProfile().linkedId)
      );
      allow update: if isTechnician() || isMaintenanceStaff();
    }
  }
}
