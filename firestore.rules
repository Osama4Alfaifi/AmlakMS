rules_version = '2';

// Requires real Firebase Authentication (see lib/auth-context.tsx) — every
// signed-in account has a users/{uid} profile doc (role + linkedId) created
// by scripts/seed.ts. These rules mirror the same "only see what's yours"
// scoping the UI applies at the database level too, so it can't be bypassed
// by talking to Firestore directly.
//
// IMPORTANT — Firestore `list` rule evaluation: a security rule for a list
// (collection/query) request must hold for the query AS ISSUED, not per
// returned document. Firestore does not filter a query down to "the docs
// you're allowed to see" — it proves (or fails to prove) the rule holds for
// every possible result of that exact query, then allows or denies the
// whole request. That means an unconstrained `collection(db, name)` read
// only ever works for roles whose access doesn't depend on document data
// (admin via the wildcard below; technician via a role check that's true
// regardless of the document). Anyone whose access depends on a field on
// the document (createdByUid, ownerId, category, ...) MUST query with a
// matching `where()` clause so Firestore can prove the rule holds for the
// constrained result set — see lib/firestore/hooks.ts (useMy*, useOwner*,
// useSupportTicketsByCategory) for the client side of this.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return signedIn() ? myProfile().role : null;
    }

    function isAdmin() {
      return signedIn() && myRole() == "admin";
    }

    function isTechnician() {
      return signedIn() && myRole() == "technician";
    }

    function isAccountant() {
      return signedIn() && myRole() == "accountant";
    }

    // An accountant only manages the owners assigned to them (see
    // app/admin/users) — this proves ownership scope for a specific
    // document's ownerId. Safe to call even when myProfile().ownerIds is
    // absent (non-accountant profiles): every caller guards this behind
    // myRole() == "accountant" first, and `&&`/`||` short-circuit here, so
    // the missing-field access never happens for other roles.
    function isMyOwner(ownerId) {
      return isAccountant() && ownerId in myProfile().ownerIds;
    }

    function isLeasingAgent() {
      return signedIn() && myRole() == "leasingAgent";
    }

    function isMaintenanceStaff() {
      return signedIn() && myRole() == "maintenanceStaff";
    }

    // A tenant's own property, resolved via their tenants/{linkedId} doc —
    // same reasoning as isMyOwner: proves scope for a specific property id.
    // Only ever called behind myRole() == "tenant" (see match /properties
    // below), so the get() only runs for tenant accounts.
    function myTenantPropertyId() {
      return get(/databases/$(database)/documents/tenants/$(myProfile().linkedId)).data.propertyId;
    }

    // Dynamic permissions engine (additive — see Role in lib/types.ts). Only
    // ever evaluated for accounts whose role is literally "custom": the
    // `myRole() == "custom"` check short-circuits `&&` before the get() runs,
    // so this never touches (or risks breaking) the 7 original roles' fixed
    // rules above. `.get(key, default)` avoids errors on a resource/action
    // the role's permission map simply never mentions.
    function customRolePermissions(resource) {
      return get(/databases/$(database)/documents/roles/$(myProfile().customRoleId)).data.permissions.get(resource, {});
    }
    function customCan(resource, action) {
      return signedIn() && myRole() == "custom" && myProfile().customRoleId != null &&
        customRolePermissions(resource).get(action, false) == true;
    }

    // Admin manages everything.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // An account can read its own profile (role/linkedId are provisioned
    // server-side by the seed script, not self-editable from the client).
    match /users/{uid} {
      // Accountants can read every profile too, to resolve actor names on
      // the activity log (app/admin/audit-log) — everyone else only ever
      // sees their own.
      allow read: if signedIn() && (request.auth.uid == uid || isAccountant());
    }

    // Reference/catalog data — but only for the roles that legitimately work
    // across every owner's listings (admin via wildcard, leasingAgent,
    // technician, maintenanceStaff — all have cross-owner jobs). Accountant,
    // owner, and tenant are each narrowed to their own scope: accountant to
    // their assigned owners, owner to their own properties, tenant to the
    // single property they occupy (resolved via myTenantPropertyId()). Every
    // owner/tenant-reachable page queries with a matching where()/get() —
    // see useOwnerProperties and the useFirestoreDoc calls in app/tenant,
    // app/tenant/maintenance, app/owner, app/owner/statement/print, app/map.
    match /properties/{id} {
      allow read: if signedIn() && (
        (myRole() != "accountant" && myRole() != "owner" && myRole() != "tenant") ||
        isMyOwner(resource.data.ownerId) ||
        (myRole() == "owner" && resource.data.ownerId == myProfile().linkedId) ||
        (myRole() == "tenant" && myTenantPropertyId() == id)
      ) || customCan("properties", "read");
      allow create: if isLeasingAgent() || customCan("properties", "write");
      allow update: if isLeasingAgent() || customCan("properties", "write");
    }
    // Admin-defined custom roles + their permission matrix — see
    // customCan() above and app/admin/roles. Reference data: any signed-in
    // account reads it (a custom-role user needs their own role's matrix to
    // build its nav — see components/layout/Sidebar.tsx); only admin writes
    // (wildcard above).
    match /roles/{id} { allow read: if signedIn(); }
    // Leasing agents onboard new owners as part of onboarding their
    // property (see app/admin/properties/new) — same write gate properties
    // itself already uses.
    match /owners/{id} {
      allow read: if signedIn();
      allow create, update: if isLeasingAgent() || customCan("properties", "write");
    }
    // Accountants register a new tenant inline when writing a contract for
    // someone not yet in the system (update covers back-filling the new
    // tenant's contractId once the contract itself has been created).
    match /tenants/{id} {
      allow read: if signedIn();
      allow create, update: if isAccountant();
    }
    match /technicians/{id} { allow read: if signedIn(); }
    // Accountants create/manage contracts (and their payment schedules) —
    // see app/admin/contracts and lib/contracts/schedule.ts — narrowed to
    // the owners assigned to them. Tenants are narrowed to their own single
    // contract (needed for app/tenant's payment-schedule view — see
    // app/api/tenant-payments/settle for how a tenant actually marks their
    // own payment paid, since writes here still require isMyOwner/customCan
    // below). Every other role (owner, leasingAgent, technician,
    // maintenanceStaff, admin) keeps its existing unrestricted read.
    match /contracts/{id} {
      allow read: if signedIn() && (
        (myRole() != "accountant" && myRole() != "tenant") ||
        isMyOwner(resource.data.ownerId) ||
        (myRole() == "tenant" && resource.data.tenantId == myProfile().linkedId)
      ) || customCan("contracts", "read");
      allow create: if isMyOwner(request.resource.data.ownerId) || customCan("contracts", "write");
      allow update: if isMyOwner(resource.data.ownerId) || customCan("contracts", "write");
    }
    // Clients: reference data readable by anyone signed in; leasing agents
    // additionally manage the CRM fields (stage/interestedPropertyId) on
    // lead records, and can add new leads.
    match /clients/{id} {
      allow read: if signedIn();
      allow create, update: if isLeasingAgent() || customCan("clients", "write");
    }
    // Invoices: same denormalized-ownerId/tenantId scoping as expenses —
    // accountant narrowed to assigned owners, owner to their own, tenant to
    // their own. No client write path exists yet (seed/admin data only), so
    // there's no create/update rule (falls through to the admin wildcard).
    match /invoices/{id} {
      allow read: if signedIn() && (
        isMyOwner(resource.data.ownerId) ||
        (myRole() == "owner" && resource.data.ownerId == myProfile().linkedId) ||
        (myRole() == "tenant" && resource.data.tenantId == myProfile().linkedId)
      );
    }
    // App-wide settings (single doc settings/app) — company profile,
    // branding, notification lead time, maintenance-mode toggle. Every
    // signed-in account reads it (branding/lead-time apply to everyone);
    // only admin writes, already covered by the wildcard rule above.
    match /settings/{id} { allow read: if signedIn(); }
    match /accountManagers/{id} { allow read: if signedIn(); }
    match /systemUsers/{id} { allow read: if signedIn(); }
    // Units: sub-records of a property (see Unit in lib/types.ts) — same
    // rule shape as properties above, reusing the "properties" custom-role
    // resource rather than a separate one, since a unit isn't independently
    // delegable.
    match /units/{id} {
      allow read: if signedIn() && (myRole() != "accountant" || isMyOwner(resource.data.ownerId)) || customCan("properties", "read");
      allow create: if isLeasingAgent() || customCan("properties", "write");
      allow update: if isLeasingAgent() || customCan("properties", "write");
    }
    // Maintenance staff manage the vendor directory day to day.
    match /vendors/{id} {
      allow read: if signedIn();
      allow create, update: if isMaintenanceStaff();
    }

    // Viewings: internal CRM tooling. Leasing agents run the pipeline day to
    // day (read/create/update); everyone else falls through to
    // default-deny except admin (wildcard above).
    match /viewings/{id} {
      allow read, create, update: if isLeasingAgent();
    }

    // Document links: admin manages the catalog (wildcard covers
    // create/update). Owners get read-only access to their own documents
    // (deeds, insurance, contract copies) via the denormalized ownerId —
    // see app/owner/documents. Every other role still falls through to
    // default-deny.
    match /documentLinks/{id} {
      allow read: if signedIn() && myRole() == "owner" && resource.data.ownerId == myProfile().linkedId;
    }

    // Receipt/disbursement vouchers — accountant tooling.
    match /vouchers/{id} {
      allow read: if isAccountant() || customCan("vouchers", "read");
      allow create, update: if isAccountant() || customCan("vouchers", "write");
    }

    // Append-only audit trail: anyone signed in can log their own action
    // (so a tenant filing a maintenance request can log it too). Read is
    // admin (wildcard above, sees every actor) plus accountant narrowed to
    // their own entries only (app/admin/audit-log) — an accountant with
    // several owners still isn't meant to see other accountants' actions.
    match /auditLogs/{id} {
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isAccountant() && resource.data.actorUid == request.auth.uid;
    }

    // Expenses: owners only see expenses on their own properties (ownerId
    // is denormalized onto each expense at creation time, same
    // list-provability reason as maintenanceRequests.ownerId above).
    // Accountants see and manage expenses on the owners assigned to them
    // (including approving payment/status update). Admin is covered by the
    // wildcard rule.
    match /expenses/{id} {
      allow read: if signedIn() && (
        isMyOwner(resource.data.ownerId) ||
        (myRole() == "owner" && resource.data.ownerId == myProfile().linkedId)
      ) || customCan("expenses", "read");
      allow create: if isMyOwner(request.resource.data.ownerId) || customCan("expenses", "write");
      allow update: if isMyOwner(resource.data.ownerId) || customCan("expenses", "write");
    }

    // Quotes: denormalized ownerId (set to the creating owner regardless of
    // the free-text propertyTitle — see app/quotes/page.tsx) scopes an
    // owner to their own quotes only; admin covered by the wildcard above.
    // An admin-authored quote not tied to a specific owner (a generic
    // service quote) simply has no ownerId and isn't owner-readable.
    match /quotes/{id} {
      allow read: if signedIn() && myRole() == "owner" && resource.data.ownerId == myProfile().linkedId;
      allow create: if signedIn() && myRole() == "owner" && request.resource.data.ownerId == myProfile().linkedId;
    }

    // Support tickets: anyone signed in can file one (as themselves only).
    // Only the sender, or the staff team routed to that category, can read
    // or update it. The technician disjunct only works for unconstrained
    // list queries because it's a constant per-user fact (see the note up
    // top); the app queries `where("category","==","الدعم الفني")` for the
    // technical-support board so that constraint plus this rule line up.
    match /supportTickets/{id} {
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.createdByUid == request.auth.uid ||
        (resource.data.category == "الدعم الفني" && isTechnician())
      );
      allow update: if signedIn() && resource.data.category == "الدعم الفني" && isTechnician();
    }

    // Maintenance requests: tenants file their own (as themselves only).
    // Visible to the tenant who filed it, technicians and maintenance staff
    // (staff — constant per-user fact, safe for an unconstrained list), and
    // the owner of the property it's on (ownerId is copied onto the request
    // at creation time so this rule doesn't need a cross-collection get()
    // keyed by a per-document field, which has the same list-provability
    // problem). Technicians and maintenance staff can both update status —
    // maintenance staff also assigns technician/vendor from
    // app/admin/maintenance.
    match /maintenanceRequests/{id} {
      allow create: if signedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.createdByUid == request.auth.uid ||
        isTechnician() ||
        isMaintenanceStaff() ||
        (myRole() == "owner" && resource.data.ownerId == myProfile().linkedId)
      ) || customCan("maintenanceRequests", "read");
      allow update: if isTechnician() || isMaintenanceStaff() || customCan("maintenanceRequests", "write");
    }
  }
}
